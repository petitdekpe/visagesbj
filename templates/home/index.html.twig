{% extends 'base.html.twig' %}
{% import '_macros/personnalite.html.twig' as m %}

{% block title %}Hisse ton Drapeau | 66 visages du Bénin
{% endblock %}

{% block body %}
	<div class="container">
		<section class="hero" aria-label="Hisse ton Drapeau, édition 2026">
			<div
				class="hero__panel" data-controller="hero-tour">
				{# 15 slots per row: the 11 faces plus an empty gutter after columns 2, 5, 6 and 9. #}
				{% set hero_pattern = [0, 1, 'gap', 2, 3, 4, 'gap', 5, 'gap', 6, 7, 8, 'gap', 9, 10] %}
				<div class="hero__grid">
					{% for row in heroFaces|batch(11, preserve_keys=false) %}
						<div class="hero__row">
							{% for slot in hero_pattern %}
								{% if slot == 'gap' or row[slot] is not defined %}
									<span class="hero__gap"></span>
								{% else %}
									<a href="{{ path('app_personnalites_show', { slug: row[slot].slug }) }}" class="hero__tile" aria-label="{{ row[slot].fullName }}">{{ m.avatar(row[slot]) }}</a>
								{% endif %}
							{% endfor %}
						</div>
						{% if loop.index == 3 %}
							{# Empty row between rows 3 and 4. #}
							<div class="hero__row">
								{% for slot in hero_pattern %}
									<span class="hero__gap"></span>
								{% endfor %}
							</div>
						{% endif %}
					{% endfor %}
				</div>

				<div class="hero__lockup">
					<span class="hero__meta-label">66 visages</span>
					<img src="{{ asset('images/branding/htd-hero.png') }}" alt="Hisse ton Drapeau">
					<span class="hero__meta-year">2026</span>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-heading">
				<span class="section-heading__bar" aria-hidden="true"></span>
				<h1 class="section-title">Hisse ton drapeau,<br>c'est quoi ?</h1>
			</div>
			<div class="section-lede">
				<p>
					À l'occasion du 66e anniversaire de l'indépendance, le Ministère du Tourisme, de la Culture et des Arts (MTCA) de la République du Bénin et la SoLE SA lancent la campagne « Hisse ton Drapeau ». Du 12 juillet au 3 août, affichez vos couleurs sur votre maison, véhicule ou bureau, et participez aux défis sur les réseaux sociaux.
																				Découvrez les 66 personnalités qui incarnent la réussite et la fierté du Bénin pour cette édition 2026.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="section-heading">
				<span class="section-heading__bar" aria-hidden="true"></span>
				<h2 class="section-title">L'hymne de la campagne</h2>
			</div>

			<div class="song-card">
				<div class="song-card__video">
					<div class="video-embed" data-controller="youtube-embed" data-youtube-embed-video-id-value="zd7NKUSMlUE">
						<img class="video-embed__thumb" src="https://i.ytimg.com/vi/zd7NKUSMlUE/hqdefault.jpg" alt="" loading="lazy">
						<button type="button" class="video-embed__play" data-action="youtube-embed#play" aria-label="Lire le clip « Hisse ton Drapeau »">
							<svg viewbox="0 0 24 24" fill="none" aria-hidden="true">
								<circle cx="12" cy="12" r="11" fill="currentColor"/>
								<path d="M10 8.3l6 3.7-6 3.7V8.3z" fill="var(--color-green-900)"/>
							</svg>
						</button>
					</div>
				</div>
				<div class="song-card__text">
					<p class="song-card__eyebrow">L'identité sonore de la campagne</p>
					<h3 class="song-card__title">Hisse ton Drapeau</h3>
					<p>
						XTIME, GHIX et Vano Baby signent l'hymne officiel de cette édition 2026. Un son rassembleur et entraînant pour accompagner la campagne du 12 juillet au 3 août.
					</p>
				</div>
			</div>
		</section>

		<section class="section section--alt">
			<div class="section-intro">
				<div class="section-heading">
					<span class="section-heading__bar" aria-hidden="true"></span>
					<h2 class="section-title">66 personnalités béninoises<br>influentes</h2>
				</div>
			</div>
			<div class="section-lede">
				<p>
					Cette campagne met à l'honneur 66 personnalités qui incarnent la réussite et la fierté du Bénin : artistes, sportifs,
																																								                    entrepreneurs, chercheurs et figures publiques.
				</p>
			</div>

			<div class="personnalites-grid personnalites-grid--featured">
				{% for personnalite in featured %}
					{{ m.card(personnalite) }}
				{% endfor %}
			</div>

			<div class="section-footer">
				<a href="{{ path('app_personnalites_index') }}" class="btn btn--primary">Voir tout &rarr;</a>
			</div>
		</section>
	</div>
{% endblock %}
