<footer class="site-footer">
	<div class="container site-footer__inner">
		<div class="site-footer__brand">
			<img src="{{ asset('images/branding/htd_blanc.png') }}" alt="Hisse ton Drapeau" width="116" height="82">
			<p>#HisseTonDrapeau | 66 ans d'indépendance, 66 visages qui font la fierté du Bénin.</p>
		</div>

		<div class="site-footer__col">
			<h2>66 visages</h2>
			<ul>
				<li><ahref="{{path('app_personnalites_index')}}">66 Visages</a></li>
				<li><ahref="{{path('app_quiz_index')}}">Quiz</a></li>
				<li><ahref="{{path('app_about')}}">À propos</a></li>
				<li><ahref="{{path('app_contact')}}">Contact</a></li>
			</ul>
		</div>

		<div class="site-footer__col">
			<h2>Édition</h2>
			<ul>
				<li><a href="#">Pourquoi 66</a></li>
				<li><a href="#">Méthode de sélection</a></li>
				<li><a href="#">Demander une correction</a></li>
			</ul>
		</div>

		{% set settings = site_settings() %}
		<div class="site-footer__col">
			<h2>Contacts</h2>
			<ul class="site-footer__contacts">
				<li>
					<span>E-mail</span>
					<em{{settings.email?'':'class="is-placeholder"'}}>{{ settings.email ?: 'à renseigner' }}</em>
				</li>
				<li>
					<span>Téléphone</span>
					<em{{settings.phone?'':'class="is-placeholder"'}}>{{ settings.phone ?: 'à renseigner' }}</em>
				</li>
				<li>
					<span>Adresse</span>
					<em{{settings.address?'':'class="is-placeholder"'}}>{{ settings.address ?: 'à renseigner' }}</em>
				</li>
			</ul>
		</div>

		<div class="site-footer__col">
			<h2>Informations légales</h2>
			<ul>
				<li>
					<a href="{{ path('app_legal_notice') }}">Mentions légales</a>
				</li>
				<li>
					<a href="{{ path('app_privacy') }}">Politique de confidentialité</a>
				</li>
				<li>
					<a href="{{ path('app_terms') }}">Conditions d'utilisation</a>
				</li>
				{% if settings.gaConfigured %}
					<li>
						<button type="button" class="site-footer__legal-action" data-controller="cookie-consent-trigger" data-action="cookie-consent-trigger#reopen">Gérer les cookies</button>
					</li>
				{% endif %}
			</ul>
		</div>
	</div>

	<div class="site-footer__bottom">
		<div class="container site-footer__bottom-inner">
			<p>&copy;
				{{ "now"|date("Y") }}
				SoLE SA, Hisse ton Drapeau. Tous droits réservés.</p>
		</div>
	</div>
</footer>
