{% extends 'base.html.twig' %}

{% block title %}Quiz des 66 visages | Hisse ton Drapeau
{% endblock %}
{% block meta_description %}Testez vos connaissances sur les 66 visages béninois qui font la fierté du Bénin, avec le quiz de la campagne Hisse ton Drapeau.
{% endblock %}

{% block body %}
	<header class="page-header">
		<div class="container">
			<h1 class="section-title">Le Quiz des 66 visages</h1>
			<p>Combien de personnalités béninoises connaissez-vous vraiment ?</p>
		</div>
	</header>

	<div class="container">
		<section class="section">
			<div class="quiz-intro">
				<div class="legal-content">
					<p>
						À l'occasion du 66e anniversaire de l'indépendance, découvrez 66 figures qui incarnent la réussite et la fierté du Bénin.
						<br>
						Testez vos connaissances avec le Quiz des 66 visages : 20 questions sur leur parcours, leurs origines et leurs anecdotes.
						<br>
						Répondez vite et bien pour maximiser votre score !
					</p>
				</div>

				{% if totalQuestions > 0 %}
					<a href="{{ path('app_quiz_play') }}" class="btn btn--primary quiz-start-btn">Lancer un quiz &rarr;</a>
				{% else %}
					<p class="is-placeholder">Aucune question disponible pour le moment.</p>
				{% endif %}
			</div>
		</section>
	</div>
{% endblock %}
