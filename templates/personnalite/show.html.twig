{% extends 'base.html.twig' %}
{% import '_macros/personnalite.html.twig' as m %}
{% import _self as local %}

{% macro editorial_block(title, text) %}
    {% if text %}
        <section class="profile-hero__block">
            <h2 class="profile-hero__block-title">{{ title }}</h2>
            {% set paragraphs = text|replace({'\r\n': '\n', '\r': '\n'})|split('\n\n') %}
            {% for paragraph in paragraphs %}
                {% if paragraph|trim is not empty %}
                    <p>{{ paragraph|trim|raw }}</p>
                {% endif %}
            {% endfor %}
        </section>
    {% endif %}
{% endmacro %}

{% block title %}{{ personnalite.fullName }} | Hisse ton Drapeau{% endblock %}
{% block meta_description %}{{ personnalite.role ?? (personnalite.fullName ~ ', l\'une des 66 personnalités béninoises de la campagne Hisse ton Drapeau.') }}{% endblock %}
{% block og_url %}{{ url('app_personnalites_show', { slug: personnalite.slug }) }}{% endblock %}
{% block og_image %}{% if personnalite.photo %}{{ absolute_url(asset('images/personnalites/' ~ personnalite.photo)) }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block body %}
    {% set share_url = url('app_personnalites_show', { slug: personnalite.slug }) %}
    {% set share_text = personnalite.fullName ~ ' | 66 visages du Bénin' %}
    <article class="profile-hero">
        <div class="profile-hero__info">
            <div class="profile-hero__info-inner">
                <a href="{{ path('app_personnalites_index') }}" class="profile-hero__back">&larr; 66 visages</a>

                <h1 class="profile-hero__name">
                    {% if personnalite.firstName %}<span>{{ personnalite.firstName }}</span>{% endif %}
                    <span>{{ personnalite.lastName }}</span>
                </h1>

                {% if personnalite.editorialEnabled %}
                    <div class="profile-hero__bio">
                        {% if personnalite.parcours %}
                            {{ local.editorial_block('Parcours', personnalite.parcours) }}
                        {% elseif personnalite.role %}
                            <section class="profile-hero__block">
                                <p>{{ personnalite.role }}</p>
                            </section>
                        {% endif %}

                        {{ local.editorial_block('Contribution au Bénin', personnalite.contributionBenin) }}
                        {{ local.editorial_block('Rayonnement', personnalite.rayonnement) }}

                        {% if personnalite.actualiteText %}
                            <section class="profile-hero__block profile-hero__actualite">
                                <h2 class="profile-hero__block-title">Actualité</h2>
                                {% if personnalite.actualiteDate %}
                                    <time class="profile-hero__actualite-date" datetime="{{ personnalite.actualiteDate|date('Y-m-d') }}">{{ personnalite.actualiteDate|date('d/m/Y') }}</time>
                                {% endif %}
                                <p>{{ personnalite.actualiteText }}</p>
                                {% if personnalite.actualiteUrl %}
                                    <a class="profile-hero__actualite-link" href="{{ personnalite.actualiteUrl }}" target="_blank" rel="noopener noreferrer">Lire la suite &rarr;</a>
                                {% endif %}
                            </section>
                        {% endif %}
                    </div>
                {% else %}
                    {% if personnalite.parcours %}
                        <div class="profile-hero__bio">
                            {% set paragraphs = personnalite.parcours|replace({'\r\n': '\n', '\r': '\n'})|split('\n\n') %}
                            {% for paragraph in paragraphs %}
                                {% if paragraph|trim is not empty %}
                                    <p>{{ paragraph|trim|raw }}</p>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% elseif personnalite.role %}
                        <div class="profile-hero__bio">
                            <p>{{ personnalite.role }}</p>
                        </div>
                    {% endif %}
                {% endif %}

                {% if personnalite.wikipediaUrl %}
                    <a class="profile-hero__wikipedia" href="{{ personnalite.wikipediaUrl }}" target="_blank" rel="noopener noreferrer">
                        Voir sur Wikipédia &rarr;
                    </a>
                {% endif %}

                {% if personnalite.achievements %}
                    {% set achievement_lines = personnalite.achievements|replace({'\r\n': '\n', '\r': '\n'})|split('\n')|slice(0, 3) %}
                    <ul class="profile-hero__achievements">
                        {% for line in achievement_lines %}
                            {% if line|trim is not empty %}
                                {% set parts = line|split('|') %}
                                <li class="profile-hero__achievement">
                                    {% if parts[1] is defined and parts[1]|trim is not empty %}
                                        <a href="{{ parts[1]|trim }}" target="_blank" rel="noopener noreferrer">{{ parts[0]|trim }}</a>
                                    {% else %}
                                        {{ parts[0]|trim }}
                                    {% endif %}
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if personnalite.editorialEnabled and personnalite.sources %}
                    {% set source_lines = personnalite.sources|replace({'\r\n': '\n', '\r': '\n'})|split('\n') %}
                    <div class="profile-hero__sources">
                        <span class="profile-hero__sources-label">Sources</span>
                        <ul class="profile-hero__sources-list">
                            {% for line in source_lines %}
                                {% if line|trim is not empty %}
                                    {% set parts = line|split('|') %}
                                    <li class="profile-hero__sources-item">
                                        {% if parts[1] is defined and parts[1]|trim is not empty %}
                                            <a href="{{ parts[1]|trim }}" target="_blank" rel="noopener noreferrer">{{ parts[0]|trim }}</a>
                                        {% else %}
                                            {{ parts[0]|trim }}
                                        {% endif %}
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <div class="profile-hero__share" data-controller="share">
                    <span class="profile-hero__share-label">Partager</span>
                    <div class="profile-hero__share-buttons">
                        <a class="profile-hero__share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Partager sur Facebook">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M14.5 21v-7.2h2.4l.4-2.8h-2.8v-1.8c0-.8.2-1.3 1.4-1.3h1.5V5.4c-.3 0-1.1-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.1H9.1v2.8h2.4V21h3z" fill="currentColor"/>
                            </svg>
                        </a>
                        <a class="profile-hero__share-btn" href="https://wa.me/?text={{ (share_text ~ ' ' ~ share_url)|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Partager sur WhatsApp">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M12 4a8 8 0 0 0-6.9 12.1L4 20l4-1.1A8 8 0 1 0 12 4z" fill="currentColor"/>
                                <path d="M9.1 8.2c.2-.4.4-.4.6-.4h.4c.1 0 .3 0 .5.4l.7 1.6c.1.1.1.3 0 .4l-.5.7c-.1.2-.2.3 0 .5.2.3.7.9 1.4 1.5.7.6 1.3.9 1.6 1 .2.1.4.1.5-.1l.5-.7c.1-.1.3-.2.5-.1l1.4.7c.2.1.3.1.4.3.1.2 0 .8-.2 1.1-.3.4-1.2.8-1.8.8-.5 0-1.1 0-3.4-1.4-1.8-1.1-2.9-2.8-3.1-3.1-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.8-2.1z" fill="var(--color-green-900)"/>
                            </svg>
                        </a>
                        <a class="profile-hero__share-btn" href="https://twitter.com/intent/tweet?url={{ share_url|url_encode }}&text={{ share_text|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Partager sur X">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </a>
                        <button type="button" class="profile-hero__share-btn profile-hero__share-btn--copy" data-share-target="copyButton" data-action="share#copyLink" data-clipboard-text="{{ share_url }}" aria-label="Copier le lien de la page">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M9.5 14.5l5-5M10.5 8.5l.9-.9a3 3 0 1 1 4.2 4.2l-.9.9M13.5 15.5l-.9.9a3 3 0 1 1-4.2-4.2l.9-.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span data-share-target="copyLabel">Copier le lien</span>
                        </button>
                    </div>
                </div>

                <img class="profile-hero__logo" src="{{ asset('images/branding/htd_blanc.png') }}" alt="Hisse ton Drapeau">
            </div>
        </div>

        <div class="profile-hero__photo">
            {% if personnalite.photo %}
                <div class="profile-hero__photo-blur" style="background-image: url('{{ asset('images/personnalites/' ~ personnalite.photo) }}')" aria-hidden="true"></div>
            {% endif %}
            <div class="profile-hero__photo-frame">
                {{ m.avatar(personnalite) }}
            </div>
        </div>
    </article>

    {% if others %}
        <div class="container">
            <section class="section">
                <div class="section-heading">
                    <span class="section-heading__bar" aria-hidden="true"></span>
                    <h2 class="section-title">Découvrez aussi</h2>
                </div>
                <div class="personnalites-grid">
                    {% for autre in others %}
                        {{ m.card(autre) }}
                    {% endfor %}
                </div>
            </section>
        </div>
    {% endif %}
{% endblock %}
