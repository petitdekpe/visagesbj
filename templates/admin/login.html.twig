{% extends 'base.html.twig' %}

{% block title %}Connexion admin | Hisse ton Drapeau{% endblock %}

{# Prevents Turbo from restoring a stale cached snapshot of this form (with an
   outdated CSRF field) on back/forward navigation. #}
{% block turbo_cache_control %}<meta name="turbo-cache-control" content="no-cache">{% endblock %}

{% block body %}
    <div class="container">
        <section class="section admin-login">
            <div class="admin-login__card">
                <h1 class="section-title">Connexion</h1>

                {% if error %}
                    <p class="admin-alert admin-alert--error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                {% endif %}

                <form method="post" class="admin-form">
                    <div class="admin-form__field">
                        <label for="username">E-mail</label>
                        <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
                    </div>

                    <div class="admin-form__field">
                        <label for="password">Mot de passe</label>
                        <input type="password" id="password" name="_password" required>
                    </div>

                    <input type="hidden" data-controller="csrf-protection" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn--primary">Se connecter</button>
                </form>

                <p><a href="{{ path('admin_forgot_password_request') }}">Mot de passe oublié ?</a></p>

                <p class="admin-login__separator">ou</p>

                <a href="{{ path('admin_login_google') }}" class="btn admin-login__google">Se connecter avec Google</a>
            </div>
        </section>
    </div>
{% endblock %}
