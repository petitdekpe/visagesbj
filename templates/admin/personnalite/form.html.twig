{% extends 'base.html.twig' %}

{% block title %}Admin | {{ personnalite.id ? 'Modifier ' ~ personnalite.fullName : 'Ajouter une personnalité' }}{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="container">
        <section class="section admin-form-section">
            <div class="section-heading">
                <span class="section-heading__bar" aria-hidden="true"></span>
                <h1 class="section-title">{{ personnalite.id ? 'Modifier' : 'Ajouter' }}</h1>
            </div>

            {% if personnalite.photo %}
                <p class="admin-current-photo">
                    <img src="{{ asset('images/personnalites/' ~ personnalite.photo) }}" alt="{{ personnalite.fullName }}">
                </p>
            {% endif %}

            {{ form_start(form, { attr: { class: 'admin-form', novalidate: 'novalidate' } }) }}
                <div class="admin-form__field">
                    {{ form_label(form.firstName) }}
                    {{ form_widget(form.firstName) }}
                    {{ form_help(form.firstName) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.lastName) }}
                    {{ form_widget(form.lastName) }}
                    {{ form_errors(form.lastName) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.role) }}
                    {{ form_widget(form.role) }}
                    {{ form_errors(form.role) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.category) }}
                    {{ form_widget(form.category) }}
                    {{ form_help(form.category) }}
                    {{ form_errors(form.category) }}
                </div>

                <div class="admin-form__field admin-form__field--checkbox">
                    {{ form_widget(form.editorialEnabled) }}
                    {{ form_label(form.editorialEnabled) }}
                </div>
                {{ form_help(form.editorialEnabled) }}

                <div class="admin-form__field">
                    {{ form_label(form.parcours) }}
                    {{ form_widget(form.parcours) }}
                    {{ form_help(form.parcours) }}
                    {{ form_errors(form.parcours) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.contributionBenin) }}
                    {{ form_widget(form.contributionBenin) }}
                    {{ form_help(form.contributionBenin) }}
                    {{ form_errors(form.contributionBenin) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.rayonnement) }}
                    {{ form_widget(form.rayonnement) }}
                    {{ form_help(form.rayonnement) }}
                    {{ form_errors(form.rayonnement) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.actualiteDate) }}
                    {{ form_widget(form.actualiteDate) }}
                    {{ form_errors(form.actualiteDate) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.actualiteText) }}
                    {{ form_widget(form.actualiteText) }}
                    {{ form_help(form.actualiteText) }}
                    {{ form_errors(form.actualiteText) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.actualiteUrl) }}
                    {{ form_widget(form.actualiteUrl) }}
                    {{ form_help(form.actualiteUrl) }}
                    {{ form_errors(form.actualiteUrl) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.wikipediaUrl) }}
                    {{ form_widget(form.wikipediaUrl) }}
                    {{ form_help(form.wikipediaUrl) }}
                    {{ form_errors(form.wikipediaUrl) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.achievements) }}
                    {{ form_widget(form.achievements) }}
                    {{ form_help(form.achievements) }}
                    {{ form_errors(form.achievements) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.sources) }}
                    {{ form_widget(form.sources) }}
                    {{ form_help(form.sources) }}
                    {{ form_errors(form.sources) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.position) }}
                    {{ form_widget(form.position) }}
                    {{ form_errors(form.position) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(form.photoFile) }}
                    {{ form_widget(form.photoFile) }}
                    {{ form_help(form.photoFile) }}
                    {{ form_errors(form.photoFile) }}
                </div>

                <div class="admin-form__actions">
                    <button type="submit" class="btn btn--primary">Enregistrer</button>
                    <a href="{{ path('admin_personnalites_index') }}" class="back-link">Annuler</a>
                </div>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
