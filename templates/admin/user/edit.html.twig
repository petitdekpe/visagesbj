{% extends 'base.html.twig' %}

{% block title %}Admin | Modifier un compte{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="container">
        <section class="section admin-form-section">
            <div class="section-heading">
                <span class="section-heading__bar" aria-hidden="true"></span>
                <h1 class="section-title">{{ adminUser.email }}</h1>
            </div>

            {{ form_start(emailForm, { attr: { class: 'admin-form' } }) }}
                <div class="admin-form__field">
                    {{ form_label(emailForm.email) }}
                    {{ form_widget(emailForm.email) }}
                    {{ form_errors(emailForm.email) }}
                </div>

                <div class="admin-form__actions">
                    <button type="submit" class="btn btn--primary">Enregistrer l'e-mail</button>
                </div>
            {{ form_end(emailForm) }}

            <p class="admin-form__section-label">Mot de passe</p>

            {{ form_start(setPasswordForm, { attr: { class: 'admin-form' }, action: path('admin_users_set_password', { id: adminUser.id }) }) }}
                <div class="admin-form__field">
                    {{ form_label(setPasswordForm.plainPassword.first) }}
                    {{ form_widget(setPasswordForm.plainPassword.first) }}
                    {{ form_errors(setPasswordForm.plainPassword.first) }}
                </div>

                <div class="admin-form__field">
                    {{ form_label(setPasswordForm.plainPassword.second) }}
                    {{ form_widget(setPasswordForm.plainPassword.second) }}
                    {{ form_errors(setPasswordForm.plainPassword.second) }}
                </div>

                <div class="admin-form__actions">
                    <button type="submit" class="btn btn--primary">Définir ce mot de passe</button>
                </div>
            {{ form_end(setPasswordForm) }}

            <form method="post" action="{{ path('admin_users_send_reset', { id: adminUser.id }) }}" class="admin-form__actions">
                <input type="hidden" name="_token" value="{{ csrf_token('send-reset-' ~ adminUser.id) }}">
                <button type="submit" class="btn">Envoyer un lien de réinitialisation par e-mail</button>
            </form>

            <p class="admin-form__section-label">Double authentification</p>

            {% if adminUser.totpSecret %}
                <form method="post" action="{{ path('admin_users_disable_2fa', { id: adminUser.id }) }}"
                      data-controller="confirm" data-action="submit->confirm#check"
                      data-confirm-message-value="Désactiver la double authentification de {{ adminUser.email }} ?"
                      class="admin-form__actions">
                    <input type="hidden" name="_token" value="{{ csrf_token('disable-2fa-' ~ adminUser.id) }}">
                    <button type="submit" class="btn">Désactiver la double authentification</button>
                </form>
            {% else %}
                <p class="admin-hint">Double authentification désactivée pour ce compte.</p>
            {% endif %}

            <p><a href="{{ path('admin_users_index') }}">&larr; Retour à la liste</a></p>
        </section>
    </div>
{% endblock %}
