{% extends 'base.html.twig' %}

{% block title %}À propos de Hisse ton Drapeau{% endblock %}
{% block meta_description %}La campagne Hisse ton Drapeau, portée par le Ministère de la Culture, des Arts et du Patrimoine du Bénin, à l'occasion des 66 ans de l'indépendance.{% endblock %}

{% block body %}
    <header class="page-header">
        <div class="container">
            <h1 class="section-title">À propos de la campagne</h1>
            <p>Une campagne du Ministère de la Culture, des Arts et du Patrimoine de la République du Bénin.</p>
        </div>
    </header>

    <div class="container">
        <section class="section">
            <div class="section-heading">
                <span class="section-heading__bar" aria-hidden="true"></span>
                <h2 class="section-title">Hisse ton drapeau,<br>c'est quoi ?</h2>
            </div>
            <div class="section-lede">
                <p>
                    « Hisse ton Drapeau » est la campagne portée par le Ministère de la Culture, des Arts
                    et du Patrimoine à l'occasion du 66<sup>e</sup> anniversaire de l'indépendance du Bénin,
                    du 12 juillet au 3 août 2026. Elle vous invite à hisser un drapeau sur votre maison,
                    votre véhicule ou votre bureau, en signe de fierté nationale.
                </p>
            </div>
        </section>

        <section class="section section--alt">
            <div class="section-heading">
                <span class="section-heading__bar" aria-hidden="true"></span>
                <h2 class="section-title">Engagement populaire</h2>
            </div>
            <div class="section-lede">
                <p>
                    La réussite de cette campagne repose avant tout sur vous. Hissez votre
                    drapeau, prenez-le en photo ou en vidéo, et partagez votre geste sous le mot-clic
                    #HisseTonDrapeau.
                </p>
            </div>
        </section>
    </div>
{% endblock %}
