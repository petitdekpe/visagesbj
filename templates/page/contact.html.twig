{% extends 'base.html.twig' %}

{% block title %}Contacts — Hisse ton Drapeau{% endblock %}
{% block meta_description %}Contactez l'équipe de la campagne Hisse ton Drapeau.{% endblock %}

{% block body %}
    <header class="page-header">
        <div class="container">
            <h1 class="section-title">Contacts</h1>
            <p>Une question sur la campagne ou sur les 66 visages ? Voici comment nous joindre.</p>
        </div>
    </header>

    <div class="container">
        <section class="section">
            <div class="contact-grid">
                <div class="contact-card">
                    <h3>E-mail</h3>
                    <p class="is-placeholder">à renseigner</p>
                </div>
                <div class="contact-card">
                    <h3>Téléphone</h3>
                    <p class="is-placeholder">à renseigner</p>
                </div>
                <div class="contact-card">
                    <h3>Adresse</h3>
                    <p class="is-placeholder">à renseigner</p>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
